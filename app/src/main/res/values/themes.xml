<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoninAI" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/ronin_highlight</item>
        <item name="android:colorPrimaryDark">@color/ronin_primary</item>
        <item name="android:colorAccent">@color/ronin_accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
        <item name="android:windowBackground">@color/ronin_surface</item>
    </style>

    <style name="Theme.RoninAI.Splash" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/ronin_surface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
